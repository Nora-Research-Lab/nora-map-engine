# Copy this file to backend/.env for local development (or set these as
# real environment variables in Render's dashboard for a deployment).
# Every value has a sensible default in app/config.py -- you only need to
# set what you want to change.

# --- General ---
APP_NAME="NORA Map Engine"
ENVIRONMENT=development

# --- CORS (comma-separated origins, or "*" for local dev) ---
# In production, pin this to the domain(s) that will embed this service,
# e.g. "https://nora-research-lab.vercel.app,https://your-platform.com"
CORS_ORIGINS=*

# --- Storage (ephemeral on Render's free tier -- see app/storage/base.py) ---
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/uploads
DERIVED_STORAGE_DIR=./data/derived
WORKSPACE_STORAGE_DIR=./data/workspaces

# --- Upload limits ---
MAX_UPLOAD_MB=25
MAX_PREVIEW_FEATURES=2000
MAX_RASTER_PREVIEW_PX=1024

# --- Hugging Face dataset catalog ---
HF_ORG=NoraResearchLab
HF_CATALOG_CACHE_SECONDS=21600
# Only needed if you make the org's datasets private:
# HF_TOKEN=hf_xxx

# --- AGDFS integration (optional, future) ---
AGDFS_BASE_URL=https://agdfs.onrender.com
